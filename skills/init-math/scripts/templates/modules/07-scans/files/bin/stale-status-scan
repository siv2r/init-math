#!/usr/bin/env python3
"""stale-status-scan: after changing a claim, find the other places that still state the old one.

selftest: yes

Give it the phrase(s) that just changed and the files that may repeat them (the document,
its index row, any source file that implements the claim). It lists every occurrence with
no correction marker nearby (the places you forgot to update), and separately the ones that
sit near a marker (read those too: a stale claim can survive inside the very correction
that supersedes it). Correction markers: the warning sign, REFUTED, RETRACTED, CORRECTED,
SUPERSEDED, DEPRECATED, WITHDRAWN, a forward arrow, or a ~~strikethrough~~.

It matches the literal phrase, so it misses a reworded restatement: it shortens review
rounds, it does not replace the claim-auditor. Run it before re-dispatching a reviewer
after a fix that changed a claim or framing phrase. Records the run time per file in
logs/state/stale-scan-times.json (the stale-scan-predispatch hook reads it).
Window: STALE_WINDOW lines either side (default 3). Advisory: always exits 0.
See docs/discipline/scans.md.

usage: bin/stale-status-scan --phrase "<old phrase>" [--phrase ...] <file> [file ...]
       bin/stale-status-scan --selftest
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MARKER_RE = re.compile(
    r"⚠|REFUTED|RETRACT|CORRECTED|SUPERSED|DEPRECATED|WITHDRAWN|⟶|➤|~~", re.I)


def scan(text: str, phrases: list[str], window: int) -> tuple[list[tuple[int, str]], list[tuple[int, str]]]:
    lines = text.splitlines()
    marked = [bool(MARKER_RE.search(ln)) for ln in lines]
    pats = [re.compile(re.escape(p), re.I) for p in phrases]
    clean, near = [], []
    for i, ln in enumerate(lines):
        if not any(p.search(ln) for p in pats):
            continue
        lo, hi = max(0, i - window), min(len(lines), i + window + 1)
        (near if any(marked[lo:hi]) else clean).append((i + 1, ln.strip()))
    return clean, near


def record(root: Path, files: list[Path]) -> None:
    state = root / "logs" / "state"
    state.mkdir(parents=True, exist_ok=True)
    f = state / "stale-scan-times.json"
    try:
        data = json.loads(f.read_text())
        if not isinstance(data, dict):
            data = {}
    except (OSError, ValueError):
        data = {}
    now = time.time()
    for p in files:
        try:
            key = p.resolve().relative_to(root.resolve()).as_posix()
        except ValueError:
            key = str(p.resolve())
        data[key] = now
    f.write_text(json.dumps(data, indent=1, sort_keys=True))


def selftest() -> int:
    doc = ("Status: supported for all n.\n\nfiller\nfiller\nfiller\nfiller\n"
           "~~supported for all n~~ CORRECTED: supported for n < 100.\n\nAbstract: supported for all n.\n")
    clean, near = scan(doc, ["supported for all n"], 3)
    if [c[0] for c in clean] != [1] or [n[0] for n in near] != [7, 9]:
        print(f"selftest FAIL: clean={clean} near={near}")
        return 1
    with tempfile.TemporaryDirectory() as d:
        root = Path(d)
        p = root / "a.md"
        p.write_text("x\n")
        record(root, [p])
        if "a.md" not in json.loads((root / "logs" / "state" / "stale-scan-times.json").read_text()):
            print("selftest FAIL: run time not recorded")
            return 1
    print("stale-status-scan selftest: ok")
    return 0


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("files", nargs="*")
    ap.add_argument("--phrase", action="append", default=[], help="a phrase that just changed (repeatable)")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args(argv)
    if a.selftest:
        return selftest()
    if not a.phrase or not a.files:
        ap.error("give at least one --phrase and one file")
    try:
        window = max(0, int(os.environ.get("STALE_WINDOW", "3")))
    except ValueError:
        window = 3
    files, n_clean, n_near = [], 0, 0
    for f in a.files:
        p = Path(f)
        try:
            text = p.read_text(encoding="utf-8", errors="replace")
        except OSError as e:
            print(f"stale-status-scan: cannot read {f}: {e}", file=sys.stderr)
            continue
        files.append(p)
        clean, near = scan(text, a.phrase, window)
        n_clean, n_near = n_clean + len(clean), n_near + len(near)
        if clean or near:
            print(f"{f}:")
        for ln, s in clean:
            print(f"   L{ln} [no correction marker nearby — update?]: {s[:160]}")
        for ln, s in near:
            print(f"   ~~ L{ln} [near a correction marker — confirm it is the corrected form]: {s[:160]}")
    record(ROOT, files)
    print(f"stale-status-scan: {n_clean} unmarked occurrence(s), {n_near} near a marker (~~).")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
