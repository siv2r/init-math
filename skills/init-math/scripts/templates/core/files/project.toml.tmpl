# {{project.name}} — project settings. Read by bin/ scripts and hooks, except where a comment
# says a value only records what init-math generated the project from.
# Generated by init-math{{#if project.init_date}} on {{project.init_date}}{{/if}}; from now on this file is yours to edit.

[project]
# Only `owner` is read at runtime; the rest records the interview.
name = {{toml.project.name}}
owner = {{toml.project.owner}}
field = {{toml.project.field}}
subarea = {{toml.project.subarea}}
research_kinds = [{{#each toml.project.research_kinds}}{{.}}{{#if !@last}}, {{/if}}{{/each}}]
harness = "{{harness.name}}"

[tiers]
# Which model plays each role. Reviewers must never run on a weaker model than the author
# of what they review. Recorded at init: the main thread's model ({{#if harness.is_claude}}`.claude/settings.json`{{else}}`.codex/config.toml`{{/if}}) and
# each agent file's model were set from these, and
# {{#if modules.usage}}only bin/usage-report reads this table later (to label models by tier){{else}}nothing reads this table later{{/if}}. To change a model, edit those files ({{#if harness.is_claude}}`.claude/agents/*.md`, `model:`{{else}}`.codex/agents/*.toml`, `model =`{{/if}}).
strong = {{toml.tiers.strong}}
worker = {{toml.tiers.worker}}

[field_profile]
# How this field's work behaves; read by agents{{#if modules.stopping}} at the deep-core gate{{/if}}{{#if modules.attempts}} and in the attack skill{{/if}}.
# A question or conjecture may override small_cases_informative with
# `small-cases: informative | not-informative` in its frontmatter.
# false where small instances say little about the claim (an estimate that only bites for
# large parameters, a phenomenon that starts beyond computable range).
small_cases_informative = {{field_profile.small_cases_informative}}
# true when the work is mostly building objects that meet criteria (a construction, a
# counterexample, a protocol) rather than proving statements about given ones.
construction = {{field_profile.construction}}

[stack]
# `tools` and `proof_assistant` record the interview; the other keys are read by bin/ and hooks.
tools = [{{#each toml.stack.tools}}{{.}}{{#if !@last}}, {{/if}}{{/each}}]
# How to run one experiment driver. Use {driver} for the script path.
run_cmd = {{toml.stack.run_cmd}}
proof_assistant = {{toml.stack.proof_assistant}}
lake_path = {{toml.stack.lake_path}}
# Programs whose failures the reflection loop should notice (leading command word).
research_commands = [{{#each toml.stack.research_commands}}{{.}}{{#if !@last}}, {{/if}}{{/each}}]

# Output patterns that mean a research command failed even if it exited 0. Started from
# init-math's defaults for the tools above; add one when a run fails in a way they miss.
{{#each toml.stack.failure_signatures}}
[[stack.failure_signatures]]
label = {{label}}
regex = {{regex}}
{{/each}}
{{#each project_toml_sections}}

{{.}}
{{/each}}
